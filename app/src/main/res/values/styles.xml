<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Absensi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#F5F9FF</item>
        <item name="android:navigationBarColor">#F5F9FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Absensi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F5F9FF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_mts_al_basroh</item>
        <item name="postSplashScreenTheme">@style/Theme.Absensi</item>
    </style>
</resources>
